{
  "auth_phone": {
    "required_for_sign_up": false
  },
  "auth_username": {
    "used_for_sign_up": true,
    "required_for_sign_up": false,
    "used_for_sign_in": true,
    "min_length": 3,
    "max_length": 24,
    "allow_extended_special_characters": false,
    "allow_numeric_usernames": false
  },
  "auth_password": {
    "enabled": true,
    "required": true,
    "min_length": 12,
    "max_length": 72,
    "require_lowercase": true,
    "require_uppercase": true,
    "require_numbers": true,
    "require_special_char": false,
    "disable_hibp": false,
    "enforce_hibp_on_sign_in": true,
    "device_trust": {
      "enabled": true
    }
  }
}
