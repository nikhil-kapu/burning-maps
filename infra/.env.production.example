TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LOCATION_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90
SUPPORT_URL=https://YOUR_PUBLIC_DOMAIN/support
