DOMAIN=api.turtlebuddy.app
TLS_EMAIL=ops@turtlebuddy.app
POSTGRES_PASSWORD=replace-with-a-long-random-password
NODE_ENV=production
PORT=8080
APP_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_BUNDLE_ID=com.turtlebuddy.app
APPLE_OAUTH_CLIENT_IDS=com.turtlebuddy.app
GOOGLE_OAUTH_CLIENT_IDS=YOUR_IOS_GOOGLE_CLIENT_ID
ACCESS_TOKEN_SECRET=replace-with-64-random-characters
REFRESH_TOKEN_PEPPER=replace-with-another-64-random-characters
FIELD_ENCRYPTION_KEY=replace-with-32-byte-base64-key
EMAIL_MODE=ses
AWS_REGION=us-west-2
SES_FROM_EMAIL=hello@turtlebuddy.app
PUSH_MODE=expo
ROUTE_UPDATES_MODE=disabled
GOOGLE_ROUTES_API_KEY=
AGENT_BRIEF_MODE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
VOICE_MODE=disabled
VAPI_PRIVATE_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
